# ========================================================
# SQLAgent Pro - Environment Configuration
# ========================================================

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
DEBUG=True

# LLM Provider Configuration ("gemini" | "groq" | "openai" | "mock")
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (Optional ultra-fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# SQLite Database Location (defaults to data/sample_database.db)
DATABASE_PATH=data/sample_database.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
